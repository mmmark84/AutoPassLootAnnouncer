package-as: AutoPassLootAnnouncer

enable-nolib-creation: no
manual-changelog: CHANGELOG.md

# Repo scaffolding that must not end up inside the packaged addon.
ignore:
  - .github
  - .vscode
  - Media
  - README.md
  - docs
  - .luacheckrc
  - .editorconfig
  - .gitattributes
  - .gitignore
  - .pkgmeta
